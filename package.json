{
	"name": "{{ remrg:var project-name }}",
	"version": "1.0.0",
	"private": true,
	"description": "",
	"author": "{{ remrg:var organization }}",
	"license": "{{ remrg:var license }}",
	"scripts": {
		"start": "next start -p 8080",
		"build": "next build",
		"dev": "next dev -p 8080",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint . --fix && prettier --write .",
		"lint:check": "prettier --check . && eslint .",
		"test": "npm run lint && npm run build && npm run test:run",
		"test:ci": "npm run lint:check && npm run typecheck && npm run test:run",
		"test:dev": "vitest --ui --coverage",
		"test:run": "vitest run --coverage && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:dev:e2e": "playwright test --ui"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.8.2"
	},
	"dependencies": {
		"next": "16.2.4",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.43.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.2",
		"@vitest/ui": "^4.1.2",
		"eslint": "^9",
		"eslint-config-next": "16.2.4",
		"prettier": "^3.8.1",
		"prettier-plugin-brace-style": "^0.10.1",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.2"
	}
}
